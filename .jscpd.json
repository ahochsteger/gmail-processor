{
  "format": ["typescript"],
  "pattern": "**/*.ts",
  "ignore": [
    "**/node_modules/**",
    "**/bak/**",
    "**/build/**",
    "**/generated/**",
    "**/.git/**",
    "**/*.json",
    "**/*.md",
    "**/*.spec.ts"
  ],
  "output": "build/jscpd",
  "reporters": ["console", "html"],
  "threshold": 1
}
