{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "workspaces": {
    ".": {
      "entry": [
        // Actions are dynamically invoked:
        "src/lib/actions/*.ts",
        "src/gas/examples/all-tests.js",
        "src/gas/examples/*/*.js",
      ],
      "project": ["src/**/*.{js,ts}"],
    },
    "docs": {
      "entry": ["src/**/*.{js,jsx,ts,tsx}"],
      "project": ["src/**/*.{js,jsx,ts,tsx}"],
    },
  },
}
