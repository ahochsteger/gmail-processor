{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "dependencyDashboard": true,
  "semanticCommits": "enabled",
  "platformAutomerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "labels": ["dependencies"],
  "prConcurrentLimit": 3,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 8am on saturday"]
  },
  "osvVulnerabilityAlerts": true,
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "schedule": ["before 8am on saturday"],
  "packageRules": [
    {
      "description": "Security vulnerability updates with stability cooldown to avoid micro-patch thrashing",
      "groupName": "deps:security",
      "matchUpdateTypes": ["vulnerability"],
      "addLabels": ["security"],
      "prPriority": 100,
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "Group @types packages",
      "groupName": "deps:types",
      "matchPackagePatterns": ["^@types/"],
      "automerge": true
    },
    {
      "description": "Keep @types/node major version in sync with devbox nodejs",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "24.x"
    },
    {
      "description": "Group @babel packages",
      "groupName": "babel monorepo",
      "matchPackagePatterns": ["^@babel/"]
    },
    {
      "description": "Group Docusaurus and React-related packages as they are tightly coupled",
      "matchPackageNames": ["react", "react-dom", "prism-react-renderer"],
      "matchPackagePatterns": ["^@docusaurus/", "^@mdx-js/"],
      "groupName": "deps:docs-docusaurus",
      "automerge": false
    },
    {
      "description": "Group eslint and typescript-eslint packages",
      "groupName": "deps:dev-eslint",
      "semanticCommitType": "build",
      "matchPackagePatterns": [
        "^@eslint/",
        "^@typescript-eslint/",
        "^eslint",
        "typescript-eslint"
      ],
      "automerge": true
    },
    {
      "description": "Group Jest packages and related test tools",
      "groupName": "deps:dev-jest",
      "semanticCommitType": "build",
      "matchPackagePatterns": ["^jest", "^@types/jest", "ts-jest", "@swc/jest"],
      "automerge": false
    },
    {
      "description": "Group Prettier packages",
      "groupName": "deps:dev-prettier",
      "semanticCommitType": "build",
      "matchPackagePatterns": ["^prettier"],
      "automerge": true
    },
    {
      "description": "Group Rollup packages and plugins",
      "groupName": "deps:dev-rollup",
      "semanticCommitType": "build",
      "matchPackagePatterns": ["^@rollup/", "rollup"]
    },
    {
      "description": "Keep typescript within tooling-compatible boundaries (defer breaking TS 7 until ecosystem is ready)",
      "matchPackageNames": ["typescript"],
      "groupName": "deps:dev-typescript",
      "semanticCommitType": "build",
      "allowedVersions": "<7.0.0",
      "automerge": false
    },
    {
      "description": "Infrastructure files non-major updates",
      "matchFileNames": [
        ".github/workflows/*.yaml",
        "devbox.json",
        ".devcontainer/Dockerfile"
      ],
      "groupName": "deps:infra-non-major",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "semanticCommitType": "build"
    },
    {
      "description": "Infrastructure files major updates",
      "matchFileNames": [
        ".github/workflows/*.yaml",
        "devbox.json",
        ".devcontainer/Dockerfile"
      ],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "semanticCommitType": "build"
    },
    {
      "description": "Unified workspace non-major updates across root and docs",
      "matchFileNames": ["package.json", "docs/package.json"],
      "groupName": "deps:workspace-non-major",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "semanticCommitType": "chore",
      "automerge": true
    },
    {
      "description": "Unified workspace major updates (requiring manual review and testing)",
      "matchFileNames": ["package.json", "docs/package.json"],
      "matchUpdateTypes": ["major"],
      "groupName": "deps:workspace-major",
      "semanticCommitType": "chore",
      "automerge": false,
      "excludePackageNames": ["react", "react-dom"]
    }
  ]
}
